# Neon PostgreSQL pooled runtime connection
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DATABASE?sslmode=require"

# Neon PostgreSQL direct migration connection
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DATABASE?sslmode=require"

# Google Gemini (server only)
GEMINI_API_KEY="replace-me"
GEMINI_MODEL="gemini-3.7-flash"

# Import safety limits
IMPORT_MAX_FILE_BYTES="10485760"
IMPORT_MAX_SHEETS="20"
IMPORT_MAX_ROWS="50000"
IMPORT_MAX_COLUMNS_PER_SHEET="250"
IMPORT_SAMPLE_ROWS_PER_SHEET="25"
IMPORT_AUTO_CONFIRM_THRESHOLD="0.82"
